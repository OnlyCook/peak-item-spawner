<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ItemSpawnerPlus</AssemblyName>
    <Product>ItemSpawnerPlus</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- BepInEx / Unity assemblies are not annotated; silence the resulting noise. -->
    <NoWarn>$(NoWarn);CS0436;CS0618;CS0649</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <RestoreAdditionalProjectSources></RestoreAdditionalProjectSources>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- R2ModManCacheRoot comes from Directory.Build.props; append the version here
         since $(Version) above isn't set yet when that file is imported -->
    <R2ModManCacheDir Condition="'$(R2ModManCacheDir)' == ''">$(R2ModManCacheRoot)/$(Version)</R2ModManCacheDir>
  </PropertyGroup>

  <!-- Game assemblies: reference everything in Managed except the framework
       facades that would clash with the netstandard2.1 reference assemblies -->
  <ItemGroup>
    <_GameAsm Include="$(GameManagedDir)/*.dll"
              Exclude="$(GameManagedDir)/System*.dll;$(GameManagedDir)/mscorlib.dll;$(GameManagedDir)/netstandard.dll;$(GameManagedDir)/Microsoft.*.dll;$(GameManagedDir)/Mono.*.dll" />
    <Reference Include="@(_GameAsm)">
      <Private>false</Private>
      <HintPath>%(_GameAsm.Identity)</HintPath>
    </Reference>
  </ItemGroup>

  <!-- toneless-pinyin table (gzipped "hanzi + ascii pinyin" lines), for zh search -->
  <ItemGroup>
    <EmbeddedResource Include="Pinyin/pinyin.bin" LogicalName="ItemSpawnerPlus.pinyin.bin" />
    <EmbeddedResource Include="Assets/flame.png" LogicalName="ItemSpawnerPlus.flame.png" />
    <EmbeddedResource Include="Assets/filter.png" LogicalName="ItemSpawnerPlus.filter.png" />
    <EmbeddedResource Include="Assets/clear.png" LogicalName="ItemSpawnerPlus.clear.png" />
    <EmbeddedResource Include="Assets/warn-error.png" LogicalName="ItemSpawnerPlus.warn-error.png" />
    <EmbeddedResource Include="Assets/warn-explode.png" LogicalName="ItemSpawnerPlus.warn-explode.png" />
    <!-- creature icons: LogicalName = ItemSpawnerPlus.creature.<file-stem>.png -->
    <EmbeddedResource Include="Assets/creatures/*.png" LogicalName="ItemSpawnerPlus.creature.%(Filename).png" />
  </ItemGroup>

  <!-- BepInEx + Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Optional: copy the built DLL straight into the r2modman profile for testing
       Enable with:  dotnet build -p:DeployToProfile=true

       Also overwrites r2modman's own cache copy of this mod (see R2ModManCacheDir
       in Directory.Build.props), because launching a profile resyncs it from that
       cache and would otherwise silently undo this deploy right before launch -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(DeployToProfile)' == 'true'">
    <MakeDir Directories="$(ProfilePluginsDir)/OnlyCook-ItemSpawnerPlus" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll"
          DestinationFolder="$(ProfilePluginsDir)/OnlyCook-ItemSpawnerPlus" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(ProfilePluginsDir)/OnlyCook-ItemSpawnerPlus" />

    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll"
          DestinationFolder="$(R2ModManCacheDir)"
          Condition="Exists('$(R2ModManCacheDir)')" />
    <Message Importance="high" Text="Also overwrote r2modman's cache copy -> $(R2ModManCacheDir)" Condition="Exists('$(R2ModManCacheDir)')" />
  </Target>

</Project>
